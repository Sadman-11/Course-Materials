* Schematics Aliases *

.ALIASES
R_R1            R1(1=$N_0002 2=$N_0001 )
R_R2            R2(1=$N_0003 2=$N_0001 )
R_R4            R4(1=$N_0001 2=$N_0004 )
E_U1            U1(OUT=$N_0004 +=$N_0001 -=0 )
V_V1            V1(+=$N_0002 -=0 )
V_V2            V2(+=$N_0003 -=0 )
R_R3            R3(1=$N_0004 2=0 )
.ENDALIASES


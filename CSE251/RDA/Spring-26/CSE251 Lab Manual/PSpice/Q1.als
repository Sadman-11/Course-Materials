* Schematics Aliases *

.ALIASES
R_Ro            Ro(1=$N_0002 2=$N_0001 )
R_Ri            Ri(1=vd+ 2=vd- )
R_R2            R2(1=vd- 2=0 )
R_R3            R3(1=vd- 2=$N_0002 )
R_R5            R5(1=$N_0002 2=0 )
E_E1            E1(3=$N_0001 4=0 1=vd+ 2=vd- )
V_V1            V1(+=vd+ -=0 )
_    _(vd+=vd+)
_    _(vd-=vd-)
.ENDALIASES

